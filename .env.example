# Copiar a .env en la raíz y definir una contraseña local antes de arrancar.
# Usar un valor alfanumérico propio compatible con Compose y Java properties.
DB_NAME=adaptativa
DB_USER=adaptativa
DB_PASSWORD=
DB_PORT=5432
# El proveedor LLM no se configura ni se utiliza en la Fase 0.

# Post-Fase-10: Gemini temporal. Sin clave/modelo se usa fallback local.
# Opciones: DISABLED, FAKE, OPENAI, GEMINI. Sin variable, default DISABLED.
LLM_PROVIDER=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=
# OpenAI permanece disponible cambiando LLM_PROVIDER a OPENAI.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=3000
LLM_MAX_RETRIES=1
