# Documentation only. Set these in Render Environment, never commit real values.
SPRING_PROFILES_ACTIVE=prod,render
LLM_PROVIDER=DISABLED
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-direct-host>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon-role>
SPRING_DATASOURCE_PASSWORD=<secret>
META_UI_USERNAME=<teacher-user>
# Replace with a unique password (12+ characters, <=72 UTF-8 bytes).
# The literal placeholder is deliberately rejected by the existing security guard.
META_UI_PASSWORD=<configure-me>
# PORT and RENDER_EXTERNAL_URL are supplied by Render, not copied from localhost.
