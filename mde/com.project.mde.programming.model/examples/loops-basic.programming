<?xml version="1.0" encoding="ASCII"?>
<programming:Program xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:programming="https://mdedu.espoch.edu.ec/model/programming/1.0" name="Ciclos b&#xe1;sicos">
  <statements xsi:type="programming:Repeat">
    <count xsi:type="programming:Literal" value="3"/>
    <body xsi:type="programming:Move"/>
    <body xsi:type="programming:TurnRight"/>
  </statements>
  <statements xsi:type="programming:While">
    <condition xsi:type="programming:SensorExpression"/>
    <body xsi:type="programming:Move"/>
  </statements>
</programming:Program>
