# Copiar a .env en la raíz y definir una contraseña local antes de arrancar.
# Usar un valor alfanumérico propio compatible con Compose y Java properties.
DB_NAME=adaptativa
DB_USER=adaptativa
DB_PASSWORD=
DB_PORT=5432
# El modo por defecto no requiere proveedor externo.

# Proveedores opcionales. Sin clave/modelo se usa fallback local.
# Opciones: DISABLED, OPENAI, GEMINI. FAKE solo para tests; rechazado en prod.
LLM_PROVIDER=DISABLED
GEMINI_API_KEY=
GEMINI_MODEL=
# OpenAI permanece disponible cambiando LLM_PROVIDER a OPENAI.
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=3000
LLM_MAX_RETRIES=1

# Fase 13: credenciales docentes propias, >=12 caracteres; sin valores predeterminados.
META_UI_USERNAME=
META_UI_PASSWORD=
LLM_RATE_LIMIT_REQUESTS=60
LLM_RATE_LIMIT_WINDOW_SECONDS=60
LLM_RATE_LIMIT_GLOBAL_REQUESTS=600
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_PORT=8088
# true para HTTPS/productivo. Solo para prueba HTTP local en loopback: false.
SESSION_COOKIE_SECURE=true
