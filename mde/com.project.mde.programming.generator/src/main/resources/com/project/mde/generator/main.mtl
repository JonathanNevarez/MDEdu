[comment encoding = UTF-8 /]
[module main('https://mdedu.espoch.edu.ec/model/programming/1.0')/]
[import com::project::mde::generator::GenerationGuards/]

[**
 * Generate one controlled JavaScript entry point from the formal Program.
 * @main
 */]
[template public generate(p : programming::Program)]
  [file ('program.js', overwrite, 'UTF-8')]
    // Generated by MDEdu Acceleo M2T.
    // Do not edit manually.
    function runProgram(runtime) {
      [for (s | p.statements)]
        [s.statement()/]
      [/for]
    }
  [/file]
[/template]

[query private key(d : programming::VariableDeclaration) : String =
  'v' + d.eContainer(programming::Program).eAllContents(programming::VariableDeclaration)->indexOf(d).toString()/]

[query private jsString(s : String) : String =
  '"' + s.substituteAll('\\', '\\\\').substituteAll('"', '\\"').substituteAll('\r', '\\r').substituteAll('\n', '\\n').substituteAll('\t', '\\t') + '"'/]

[template private statement(s : programming::Move)]
  runtime.move();
[/template]
[template private statement(s : programming::TurnLeft)]
  runtime.turnLeft();
[/template]
[template private statement(s : programming::TurnRight)]
  runtime.turnRight();
[/template]
[template private statement(s : programming::VariableDeclaration)]
  runtime.declareVariable([s.key().jsString()/], [s.name.jsString()/], [s.type.toString().jsString()/], [if (s.initialValue <> null)][s.initialValue.expression()/][else]null[/if]);
[/template]
[template private statement(s : programming::Assignment)]
  runtime.assignVariable([s.target.key().jsString()/], [s.value.expression()/]);
[/template]
[template private statement(s : programming::Repeat)]
  runtime.repeat([s.count.expression()/], () => {
    [for (child | s.body)]
      [child.statement()/]
    [/for]
  });
[/template]
[template private statement(s : programming::While)]
  runtime.whileLoop(() => [s.condition.expression()/], () => {
    [for (child | s.body)]
      [child.statement()/]
    [/for]
  });
[/template]
[template private statement(s : programming::If)]
  runtime.ifThen(() => [s.condition.expression()/], () => {
    [for (child | s.thenBranch)]
      [child.statement()/]
    [/for]
  });
[/template]
[template private statement(s : programming::IfElse)]
  runtime.ifElse(() => [s.condition.expression()/], () => {
    [for (child | s.thenBranch)]
      [child.statement()/]
    [/for]
  }, () => {
    [for (child | s.elseBranch)]
      [child.statement()/]
    [/for]
  });
[/template]
[template private expression(e : programming::Literal) post(self.trim())]
  runtime.literal([e.type.toString().jsString()/], [e.value.jsString()/])
[/template]
[template private expression(e : programming::VariableReference) post(self.trim())]
  runtime.getVariable([e.declaration.key().jsString()/])
[/template]
[template private expression(e : programming::Comparison) post(self.trim())]
  runtime.compare([e.operator.toString().jsString()/], [e.left.expression()/], [e.right.expression()/])
[/template]
[template private expression(e : programming::BooleanExpression) post(self.trim())]
  runtime.boolean([e.operator.toString().jsString()/], [e.left.expression()/][if (e.operator <> programming::BooleanOperator::NOT)], [e.right.expression()/][/if])
[/template]
[template private expression(e : programming::SensorExpression) post(self.trim())]
  runtime.sensor([e.sensor.toString().jsString()/])
[/template]

[template private statement(s : programming::Statement)]
  [s.unsupported()/]
[/template]
[template private expression(e : programming::Expression) post(self.trim())]
  [e.unsupported()/]
[/template]
